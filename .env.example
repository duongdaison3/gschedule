# ==========================================
# Cấu hình Cơ sở dữ liệu (PostgreSQL / Aiven)
# ==========================================

# 1. DATABASE_URL: Kết nối ứng dụng cho môi trường dev (Aiven hoặc Localhost).
# Sử dụng role gschedule_app với quyền tối thiểu. Yêu cầu sslmode=require khi kết nối Aiven.
DATABASE_URL="postgres://gschedule_app:your_dev_password@pg-service-project.aivencloud.com:port/gschedule_dev?sslmode=require"

# 2. DATABASE_MIGRATE_URL: Kết nối trực tiếp (không qua pooler) dùng cho migration (role owner / avnadmin).
# Nếu để trống, hệ thống sẽ tự động sử dụng DATABASE_URL.
DATABASE_MIGRATE_URL="postgres://avnadmin:your_owner_password@pg-service-project.aivencloud.com:port/gschedule_dev?sslmode=require"

# 3. DATABASE_TEST_URL: Database dùng riêng cho test tích hợp (mặc định Docker localhost:5433).
# CẤM trùng với DATABASE_URL và phải có hậu tố _test.
DATABASE_TEST_URL="postgresql://postgres:postgrespassword@localhost:5433/gschedule_test"

# 4. PG_CA_CERT: Đường dẫn tới file chứng chỉ CA (.pem) hoặc nội dung chuỗi PEM (tùy chọn).
# PG_CA_CERT="./ca.pem"

# 5. DB_POOL_MAX: Giới hạn kết nối pool cho ứng dụng (mặc định: 5; khuyến nghị ≤ 5 cho gói free của Aiven).
DB_POOL_MAX=5

# Cờ an toàn (tùy chọn): Đặt bằng 1 nếu bắt buộc cho phép chạy reset/seed trên database không có hậu tố _dev/_test.
# ALLOW_DESTRUCTIVE_DB=0

# Mật khẩu thiết lập khi chạy script db:create-app-role (tùy chọn)
# APP_ROLE_PASSWORD="gschedule_app_secure_password"

# ==========================================
# Cấu hình Ứng dụng Next.js
# ==========================================
# Better Auth Infra API key (server-only; không đưa vào client)
# BETTER_AUTH_API_KEY="your-better-auth-api-key"
PORT=3000
NODE_ENV="development"
